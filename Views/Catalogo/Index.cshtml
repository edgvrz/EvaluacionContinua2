@model IEnumerable<PortalInmobiliario.Models.CatalogoItemDto>
@using PortalInmobiliario.Models

@{
    ViewData["Title"] = "Catálogo de Inmuebles";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col">
            <input type="text" name="ciudad" placeholder="Ciudad"
                   value="@ViewContext.HttpContext.Request.Query["ciudad"]"
                   class="form-control" />
        </div>
        <div class="col">
            <select name="tipo" class="form-control">
                <option value="">-- Tipo --</option>
                @foreach (var t in Enum.GetValues(typeof(TipoInmueble)))
{
    if (ViewContext.HttpContext.Request.Query["tipo"] == t.ToString())
    {
        <text><option value="@t" selected>@t</option></text>
    }
    else
    {
        <text><option value="@t">@t</option></text>
    }
}
            </select>
        </div>
        <div class="col">
            <input type="number" name="precioMin" placeholder="Precio mínimo"
                   value="@ViewContext.HttpContext.Request.Query["precioMin"]"
                   class="form-control" />
        </div>
        <div class="col">
            <input type="number" name="precioMax" placeholder="Precio máximo"
                   value="@ViewContext.HttpContext.Request.Query["precioMax"]"
                   class="form-control" />
        </div>
        <div class="col">
            <input type="number" name="dormitorios" placeholder="Dormitorios ≥"
                   value="@ViewContext.HttpContext.Request.Query["dormitorios"]"
                   class="form-control" />
        </div>
        <div class="col">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </div>
</form>

<hr />

@if (!Model.Any())
{
    <p>No se encontraron inmuebles.</p>
}
else
{
    <div class="row">
        @foreach (var i in Model)
        {
            <div class="col-md-4">
                <div class="card mb-3">
                    <img src="@i.Imagen" class="card-img-top" alt="Imagen de @i.Titulo" />
                    <div class="card-body">
                        <h5>@i.Titulo</h5>
                        <p>@i.Ciudad - @i.Direccion</p>
                        <p><b>Precio:</b> @i.Precio.ToString("C")</p>
                        <a class="btn btn-sm btn-info" asp-action="Detalle" asp-route-id="@i.Id">
                            Ver detalle
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
